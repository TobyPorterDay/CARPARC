# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Needed by nz_vehicle_resolver for titles not in the shipped LLM cache.
ANTHROPIC_API_KEY=

# Trade Me API (scrape_trademe.py, sync.py). sync.py falls back to "fake"
# values when these are unset, which is all fake_trademe.py needs.
TRADEME_CONSUMER_KEY=
TRADEME_CONSUMER_SECRET=
TRADEME_TOKEN=
TRADEME_TOKEN_SECRET=
